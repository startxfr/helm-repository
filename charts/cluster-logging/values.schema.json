{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "context": {
            "type": "object",
            "title": "Deployment context",
            "description": "Properties of the deployment context.",
            "required": [
                "scope",
                "cluster",
                "environment",
                "component",
                "app"
            ],
            "properties": {
                "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Scope name",
                    "description": "Name of the global scope for this application. Define an organisational tenant.",
                    "default": "myscope",
                    "examples": [
                        "myscope",
                        "mycustomer"
                    ]
                },
                "cluster": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Cluster name",
                    "description": "Name of the cluster running this application. Define a platform tenant.",
                    "default": "localhost",
                    "examples": [
                        "mycluster",
                        "localhost"
                    ]
                },
                "environment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Environement name",
                    "description": "Name of the environement for this application. Define a stage tenant.",
                    "default": "dev",
                    "examples": [
                        "dev",
                        "factory",
                        "preprod",
                        "prod"
                    ]
                },
                "component": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Component name",
                    "description": "Name of the component consisting of this application. Define a logical tenant.",
                    "default": "sxapi",
                    "examples": [
                        "mycomp",
                        "myservice"
                    ]
                },
                "app": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "title": "Application name",
                    "description": "Name of the application name. Define a functionnal tenant.",
                    "default": "default-sxapi",
                    "examples": [
                        "myapp",
                        "mymicroservice"
                    ]
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "title": "Version name",
                    "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                    "default": "0.0.1",
                    "examples": [
                        "0.0.1",
                        "0.1",
                        "0.0.1-snapshot",
                        "0.0.1-202110300900"
                    ]
                }
            }
        },
        "eventrouter": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "replicas": {
                    "type": "integer"
                },
                "resources": {
                    "type": "object"
                }
            }
        },
        "logforwarder": {
            "type": "object",
            "properties": {
                "apiVersion": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "secret": {
                    "type": "object",
                    "properties": {
                        "externalSecret": {
                            "$ref": "#/definitions/externalSecret"
                        }
                    }
                }
            }
        },
        "logging": {
            "type": "object",
            "properties": {
                "apiVersion": {
                    "type": "string"
                },
                "curation": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "resources": {
                            "type": "object"
                        },
                        "schedule": {
                            "type": "string"
                        }
                    }
                },
                "elasticsearch": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "replicas": {
                            "type": "integer"
                        },
                        "resources": {
                            "type": "object"
                        },
                        "storage": {
                            "type": "object",
                            "properties": {
                                "class": {
                                    "type": "string"
                                },
                                "size": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "collector": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "type": {
                            "type": "string"
                        },
                        "resources": {
                            "type": "object"
                        }
                    }
                },
                "hooked": {
                    "type": "boolean"
                },
                "kibana": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "replicas": {
                            "type": "integer"
                        },
                        "resources": {
                            "type": "object"
                        }
                    }
                },
                "managementState": {
                    "type": "string"
                }
            }
        },
        "operator": {
            "type": "object",
            "properties": {
                "operatorGroup": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "providedAPIs": {
                            "type": "string"
                        }
                    }
                },
                "subscription": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "operator": {
                            "type": "object",
                            "properties": {
                                "channel": {
                                    "type": "string"
                                },
                                "csv": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "source": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "namespace": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 30,
                            "title": "Version name",
                            "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                            "default": "0.0.1",
                            "examples": [
                                "0.0.1",
                                "0.1",
                                "0.0.1-snapshot",
                                "0.0.1-202110300900"
                            ]
                        }
                    }
                }
            }
        },
        "operatorElastic": {
            "type": "object",
            "properties": {
                "context": {
                    "type": "object",
                    "properties": {
                        "app": {
                            "type": "string"
                        },
                        "cluster": {
                            "type": "string"
                        },
                        "component": {
                            "type": "string"
                        },
                        "environment": {
                            "type": "string"
                        },
                        "scope": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "operatorGroup": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "providedAPIs": {
                            "type": "string"
                        },
                        "target": {
                            "type": "string"
                        }
                    }
                },
                "subscription": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "operator": {
                            "type": "object",
                            "properties": {
                                "channel": {
                                    "type": "string"
                                },
                                "csv": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "source": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "namespace": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 30,
                            "title": "Version name",
                            "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                            "default": "0.0.1",
                            "examples": [
                                "0.0.1",
                                "0.1",
                                "0.0.1-snapshot",
                                "0.0.1-202110300900"
                            ]
                        }
                    }
                }
            }
        },
        "project": {
            "type": "object",
            "properties": {
                "context": {
                    "type": "object",
                    "properties": {
                        "app": {
                            "type": "string"
                        },
                        "cluster": {
                            "type": "string"
                        },
                        "component": {
                            "type": "string"
                        },
                        "environment": {
                            "type": "string"
                        },
                        "scope": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "networkpolicy": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "project": {
                    "type": "object",
                    "properties": {
                        "description": {
                            "type": "string"
                        },
                        "display_name": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string"
                        }
                    }
                },
                "quotas": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "rbac": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "groups": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "externalSecretDefaults": {
            "type": "object",
            "description": "Default settings of the ExternalSecret objects rendered by this chart",
            "properties": {
                "apiVersion": {
                    "type": "string"
                },
                "refreshInterval": {
                    "type": "string"
                },
                "secretStoreRef": {
                    "$ref": "#/definitions/externalSecretStoreRef"
                }
            }
        }
    },
    "definitions": {
        "externalSecretStoreRef": {
            "type": "object",
            "description": "SecretStore or ClusterSecretStore to read from",
            "properties": {
                "name": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "SecretStore",
                        "ClusterSecretStore"
                    ]
                }
            }
        },
        "externalSecret": {
            "type": "object",
            "description": "Source this secret from an external store (External Secrets Operator ExternalSecret) instead of the chart values",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Render an ExternalSecret producing the same Secret instead of the Secret itself"
                },
                "apiVersion": {
                    "type": "string"
                },
                "refreshInterval": {
                    "type": "string"
                },
                "secretStoreRef": {
                    "$ref": "#/definitions/externalSecretStoreRef"
                },
                "remoteRefs": {
                    "type": "object",
                    "description": "Map of target secret keys to ExternalSecret remoteRef",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "key": {
                                "type": "string"
                            },
                            "property": {
                                "type": "string"
                            },
                            "version": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "key"
                        ]
                    }
                },
                "data": {
                    "type": "array",
                    "description": "Raw ExternalSecret spec.data entries",
                    "items": {
                        "type": "object"
                    }
                },
                "dataFrom": {
                    "type": "array",
                    "description": "Raw ExternalSecret spec.dataFrom entries",
                    "items": {
                        "type": "object"
                    }
                },
                "template": {
                    "type": "object",
                    "description": "Raw ExternalSecret spec.target.template"
                }
            }
        }
    }
}