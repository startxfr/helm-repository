{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "context": {
            "type": "object",
            "title": "Deployment context",
            "description": "Properties of the deployment context.",
            "required": [
                "scope",
                "cluster",
                "environment",
                "component",
                "app"
            ],
            "properties": {
                "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Scope name",
                    "description": "Name of the global scope for this application. Define an organizational tenant.",
                    "default": "myscope",
                    "examples": [
                        "myscope",
                        "mycustomer"
                    ]
                },
                "cluster": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Cluster name",
                    "description": "Name of the cluster running this application. Define a platform tenant.",
                    "default": "localhost",
                    "examples": [
                        "mycluster",
                        "localhost"
                    ]
                },
                "environment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Environment name",
                    "description": "Name of the environment for this application. Define a stage tenant.",
                    "default": "dev",
                    "examples": [
                        "dev",
                        "factory",
                        "preprod",
                        "prod"
                    ]
                },
                "component": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Component name",
                    "description": "Name of the component consisting of this application. Define a logical tenant.",
                    "default": "sxapi",
                    "examples": [
                        "mycomp",
                        "myservice"
                    ]
                },
                "app": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "title": "Application name",
                    "description": "Name of the application name. Define a functional tenant.",
                    "default": "default-sxapi",
                    "examples": [
                        "myapp",
                        "mymicroservice"
                    ]
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "title": "Version name",
                    "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                    "default": "0.0.1",
                    "examples": [
                        "0.0.1",
                        "0.1",
                        "0.0.1-snapshot",
                        "0.0.1-202110300900"
                    ]
                }
            }
        },
        "hyperconvergedCluster": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "hooked": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "storageClass": {
                    "type": "string"
                },
                "evictionStrategy": {
                    "title": "Eviction Strategy",
                    "type": "string",
                    "default": "None",
                    "description": "Eviction strategy applied to the virtual machines when a node is drained: None (VMs are shut down), LiveMigrate (VMs are live migrated, they must be migratable) or LiveMigrateIfPossible"
                },
                "liveMigration": {
                    "type": "object",
                    "title": "Live Migration",
                    "description": "Live migration settings (spec.liveMigrationConfig of the HyperConverged CR)",
                    "properties": {
                        "network": {
                            "title": "Network",
                            "type": "string",
                            "default": "",
                            "description": "Name of a NetworkAttachmentDefinition, in the HyperConverged namespace, carrying the live migration traffic on a dedicated network (ex: a bond interface). Empty uses the pod network. See the nads block"
                        },
                        "allowAutoConverge": {
                            "title": "Allow Auto Converge",
                            "type": "boolean",
                            "default": false,
                            "description": "Allow the migration to slow down the virtual machine so that it converges"
                        },
                        "allowPostCopy": {
                            "title": "Allow Post Copy",
                            "type": "boolean",
                            "default": false,
                            "description": "Allow post-copy migrations"
                        },
                        "completionTimeoutPerGiB": {
                            "title": "Completion Timeout Per Gi B",
                            "type": "integer",
                            "default": 800,
                            "description": "Maximum time in seconds, per GiB of memory, for a migration to complete"
                        },
                        "parallelMigrationsPerCluster": {
                            "title": "Parallel Migrations Per Cluster",
                            "type": "integer",
                            "default": 5,
                            "description": "Maximum number of migrations running in parallel in the cluster"
                        },
                        "parallelOutboundMigrationsPerNode": {
                            "title": "Parallel Outbound Migrations Per Node",
                            "type": "integer",
                            "default": 2,
                            "description": "Maximum number of outbound migrations per node"
                        },
                        "progressTimeout": {
                            "title": "Progress Timeout",
                            "type": "integer",
                            "default": 150,
                            "description": "Time in seconds without progress before a migration is aborted"
                        }
                    }
                }
            }
        },
        "operator": {
            "type": "object",
            "properties": {
                "context": {
                    "type": "object",
                    "properties": {
                        "app": {
                            "type": "string"
                        },
                        "cluster": {
                            "type": "string"
                        },
                        "component": {
                            "type": "string"
                        },
                        "environment": {
                            "type": "string"
                        },
                        "scope": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "operatorGroup": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "providedAPIs": {
                            "type": "string"
                        }
                    }
                },
                "subscription": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "operator": {
                            "type": "object",
                            "properties": {
                                "channel": {
                                    "type": "string"
                                },
                                "csv": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "source": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "namespace": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 30,
                            "title": "Version name",
                            "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                            "default": "0.0.1",
                            "examples": [
                                "0.0.1",
                                "0.1",
                                "0.0.1-snapshot",
                                "0.0.1-202110300900"
                            ]
                        }
                    }
                }
            }
        },
        "project": {
            "type": "object",
            "properties": {
                "context": {
                    "type": "object",
                    "properties": {
                        "app": {
                            "type": "string"
                        },
                        "cluster": {
                            "type": "string"
                        },
                        "component": {
                            "type": "string"
                        },
                        "environment": {
                            "type": "string"
                        },
                        "scope": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "networkpolicy": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "rules": {
                            "type": "array"
                        }
                    }
                },
                "project": {
                    "type": "object",
                    "properties": {
                        "description": {
                            "type": "string"
                        },
                        "display_name": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "requester": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string"
                        }
                    }
                },
                "quotas": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "rbac": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "vms": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "list": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "cloudInit": {
                                "type": "string"
                            },
                            "hostname": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "namespace": {
                                "type": "string"
                            },
                            "os": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "signature": {
                                        "type": "string"
                                    }
                                }
                            },
                            "storage": {
                                "type": "object",
                                "properties": {
                                    "boot_image": {
                                        "type": "string"
                                    },
                                    "boot_size": {
                                        "type": "string"
                                    },
                                    "boot_storageclass": {
                                        "type": "string"
                                    },
                                    "boot_type": {
                                        "type": "string"
                                    },
                                    "disks": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "boot_order": {
                                                    "type": "integer"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "size": {
                                                    "type": "string"
                                                },
                                                "storageclass": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "nads": {
            "type": "object",
            "title": "Nads",
            "description": "NetworkAttachmentDefinitions (Multus secondary networks) used by the virtual machines or by the live migration network",
            "properties": {
                "enabled": {
                    "title": "Enabled",
                    "type": "boolean",
                    "default": false,
                    "description": "Enable the creation of the NetworkAttachmentDefinition list"
                },
                "hooked": {
                    "title": "Hooked",
                    "type": "boolean",
                    "default": false,
                    "description": "Activate the resources as a helm hook"
                },
                "list": {
                    "type": "array",
                    "title": "List",
                    "description": "List of NetworkAttachmentDefinition to create. Example: a macvlan network on the bond1 interface dedicated to live migrations, referenced by hyperconvergedCluster.liveMigration.network",
                    "default": []
                }
            }
        }
    }
}
