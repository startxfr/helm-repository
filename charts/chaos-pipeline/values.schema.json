{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/context",
      "required": [
        "scope",
        "cluster",
        "environment",
        "component",
        "app"
      ]
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "pipeline": {
      "type": "object",
      "title": "Chaos pipelines",
      "description": "Configuration of the Tekton chaos tasks and pipelines",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable the pipelines",
          "description": "Deploy the chaos tasks and pipelines. No PipelineRun is created",
          "default": false
        },
        "images": {
          "type": "object",
          "title": "Images",
          "description": "Container images used by the tasks",
          "properties": {
            "krkn": {
              "type": "object",
              "title": "krkn image",
              "description": "krkn image",
              "properties": {
                "repository": {
                  "type": "string",
                  "title": "Image repository",
                  "description": "Image repository",
                  "default": "quay.io/krkn-chaos/krkn"
                },
                "tag": {
                  "type": "string",
                  "title": "Image tag",
                  "description": "Image tag, used when no digest is set",
                  "default": "v5.2.15"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[a-f0-9]{64})?$",
                  "title": "Image digest",
                  "description": "Image digest, takes precedence over the tag"
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ],
                  "title": "Image pull policy",
                  "default": "IfNotPresent"
                }
              }
            },
            "hub": {
              "type": "object",
              "title": "krkn-hub images",
              "description": "krkn-hub images",
              "properties": {
                "repository": {
                  "type": "string",
                  "title": "Image repository",
                  "description": "Image repository",
                  "default": "quay.io/krkn-chaos/krkn-hub"
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ],
                  "title": "Image pull policy",
                  "default": "Always"
                }
              }
            },
            "check": {
              "type": "object",
              "title": "Check image",
              "description": "Check image",
              "properties": {
                "repository": {
                  "type": "string",
                  "title": "Image repository",
                  "description": "Image repository",
                  "default": "registry.access.redhat.com/ubi9/ubi-minimal"
                },
                "tag": {
                  "type": "string",
                  "title": "Image tag",
                  "description": "Image tag, used when no digest is set",
                  "default": "9.9"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[a-f0-9]{64})?$",
                  "title": "Image digest",
                  "description": "Image digest, takes precedence over the tag"
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ],
                  "title": "Image pull policy",
                  "default": "IfNotPresent"
                }
              }
            }
          }
        },
        "privileged": {
          "type": "boolean",
          "title": "Privileged",
          "description": "Run the krkn steps as privileged (binds the service account to the privileged SCC)",
          "default": false
        },
        "imageSignatureVerification": {
          "type": "boolean",
          "title": "Image signature verification",
          "description": "Verify the signature of the workload images started by krkn",
          "default": true
        },
        "resources": {
          "type": "object",
          "title": "Resources",
          "description": "Resources requests and limits of the krkn steps"
        },
        "checkResources": {
          "type": "object",
          "title": "Check resources",
          "description": "Resources requests and limits of the cerberus-check step"
        },
        "rbac": {
          "type": "object",
          "title": "RBAC",
          "description": "Access rights of the chaos-pipeline service account",
          "properties": {
            "clusterAdmin": {
              "type": "boolean",
              "title": "Cluster admin",
              "description": "Bind the service account to cluster-admin instead of the chaos ClusterRole of this chart",
              "default": false
            },
            "extraRules": {
              "type": "array",
              "title": "Extra rules",
              "description": "Rules added to the chaos ClusterRole of this chart",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "cloud": {
          "type": "object",
          "title": "Cloud",
          "description": "Cloud provider access, used by the node and zone scenarios",
          "properties": {
            "existingSecret": {
              "type": "string",
              "title": "Existing secret",
              "description": "Name of an existing Secret whose keys are exposed as environment variables",
              "default": ""
            }
          }
        },
        "cerberus": {
          "type": "object",
          "title": "Cerberus",
          "description": "Cerberus go/no-go signal, defaults of the pipeline parameters",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enabled",
              "description": "Gate the pipelines with the cerberus signal",
              "default": true
            },
            "url": {
              "type": "string",
              "title": "Cerberus URL",
              "description": "URL of the cerberus signal",
              "default": "http://cerberus.chaos-pipeline.svc.cluster.local:8080"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "title": "Timeout",
              "description": "Maximum time to wait for a healthy signal (in seconds)",
              "default": 300
            }
          }
        },
        "infra": {
          "type": "object",
          "title": "Infrastructure pipeline",
          "description": "Pipeline chaos-infra: chaos testing of the cluster infrastructure",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enabled",
              "description": "Deploy the chaos-infra pipeline",
              "default": true
            },
            "healthCheckUrl": {
              "type": "string",
              "title": "Health check URL",
              "description": "Default HTTP endpoint checked by krkn before and after each scenario",
              "default": ""
            },
            "scenarios": {
              "type": "object",
              "title": "Scenarios",
              "description": "Scenarios of the pipeline, one task each, run in alphabetical order of their name",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "title": "Enabled",
                    "description": "Add this scenario to the pipeline",
                    "default": false
                  },
                  "engine": {
                    "enum": [
                      "core",
                      "hub"
                    ],
                    "title": "Engine",
                    "description": "core (krkn image) or hub (krkn-hub image)",
                    "default": "core"
                  },
                  "type": {
                    "type": "string",
                    "title": "Scenario type",
                    "description": "krkn scenario type (core engine)",
                    "default": ""
                  },
                  "content": {
                    "type": [
                      "object",
                      "array",
                      "string"
                    ],
                    "title": "Scenario content",
                    "description": "Scenario definition, in the krkn format of this type (core engine)"
                  },
                  "tag": {
                    "type": "string",
                    "title": "Image tag",
                    "description": "krkn-hub image tag (hub engine)",
                    "default": ""
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^(sha256:[a-f0-9]{64})?$",
                    "title": "Image digest",
                    "description": "krkn-hub image digest (hub engine)"
                  },
                  "env": {
                    "type": "object",
                    "title": "Environment",
                    "description": "Environment variables of the scenario (hub engine)",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "waitDuration": {
                    "type": "integer",
                    "minimum": 0,
                    "title": "Wait duration",
                    "description": "Time to wait after the scenario, in seconds (core engine)",
                    "default": 30
                  },
                  "timeout": {
                    "type": "string",
                    "title": "Timeout",
                    "description": "Timeout of the task",
                    "default": "1h0m0s"
                  },
                  "recoveryTime": {
                    "type": "integer",
                    "minimum": 1,
                    "title": "Recovery time",
                    "description": "Value of the RECOVERY_TIME placeholder for this scenario, in seconds"
                  }
                }
              }
            },
            "recoveryTime": {
              "type": "integer",
              "minimum": 1,
              "title": "Recovery time",
              "description": "Default time given to a target to recover, in seconds",
              "default": 180
            }
          }
        },
        "application": {
          "type": "object",
          "title": "Application pipeline",
          "description": "Pipeline chaos-application: chaos testing of an application stack",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enabled",
              "description": "Deploy the chaos-application pipeline",
              "default": true
            },
            "targetNamespace": {
              "type": "string",
              "title": "Target namespace",
              "description": "Default namespace of the application under chaos",
              "default": ""
            },
            "labelSelector": {
              "type": "string",
              "title": "Label selector",
              "description": "Default label selector of the application pods",
              "default": ""
            },
            "healthCheckUrl": {
              "type": "string",
              "title": "Health check URL",
              "description": "Default HTTP endpoint checked by krkn before and after each scenario",
              "default": ""
            },
            "scenarios": {
              "type": "object",
              "title": "Scenarios",
              "description": "Scenarios of the pipeline, one task each, run in alphabetical order of their name",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "title": "Enabled",
                    "description": "Add this scenario to the pipeline",
                    "default": false
                  },
                  "engine": {
                    "enum": [
                      "core",
                      "hub"
                    ],
                    "title": "Engine",
                    "description": "core (krkn image) or hub (krkn-hub image)",
                    "default": "core"
                  },
                  "type": {
                    "type": "string",
                    "title": "Scenario type",
                    "description": "krkn scenario type (core engine)",
                    "default": ""
                  },
                  "content": {
                    "type": [
                      "object",
                      "array",
                      "string"
                    ],
                    "title": "Scenario content",
                    "description": "Scenario definition, in the krkn format of this type (core engine)"
                  },
                  "tag": {
                    "type": "string",
                    "title": "Image tag",
                    "description": "krkn-hub image tag (hub engine)",
                    "default": ""
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^(sha256:[a-f0-9]{64})?$",
                    "title": "Image digest",
                    "description": "krkn-hub image digest (hub engine)"
                  },
                  "env": {
                    "type": "object",
                    "title": "Environment",
                    "description": "Environment variables of the scenario (hub engine)",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "waitDuration": {
                    "type": "integer",
                    "minimum": 0,
                    "title": "Wait duration",
                    "description": "Time to wait after the scenario, in seconds (core engine)",
                    "default": 30
                  },
                  "timeout": {
                    "type": "string",
                    "title": "Timeout",
                    "description": "Timeout of the task",
                    "default": "1h0m0s"
                  },
                  "recoveryTime": {
                    "type": "integer",
                    "minimum": 1,
                    "title": "Recovery time",
                    "description": "Value of the RECOVERY_TIME placeholder for this scenario, in seconds"
                  }
                }
              }
            },
            "recoveryTime": {
              "type": "integer",
              "minimum": 1,
              "title": "Recovery time",
              "description": "Default time given to a target to recover, in seconds",
              "default": 120
            }
          }
        },
        "privilegedWorkloads": {
          "enum": [
            "auto",
            true,
            false,
            "true",
            "false"
          ],
          "title": "Privileged workloads",
          "description": "Give the service account the privileged SCC in privilegedNamespaces, for the helper pods of the node level scenarios (auto: when an enabled scenario needs it)",
          "default": "auto"
        },
        "privilegedNamespaces": {
          "type": "array",
          "title": "Privileged namespaces",
          "description": "Namespaces where krkn starts its helper pods",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "default": [
            "default"
          ]
        },
        "nodeSelector": {
          "type": "string",
          "title": "Node selector",
          "description": "Label selector of the nodes targeted by the node level scenarios",
          "default": "node-role.kubernetes.io/worker="
        },
        "workloadNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "title": "Workload namespace",
          "description": "Namespace where krkn starts the helper pods of the node level scenarios",
          "default": "default"
        },
        "checkCriticalAlerts": {
          "type": "boolean",
          "title": "Check critical alerts",
          "description": "Fail a scenario when a critical alert is firing after the chaos",
          "default": false
        },
        "healthCheck": {
          "type": "object",
          "title": "Health check",
          "description": "HTTP health check run by krkn before and after each scenario",
          "properties": {
            "interval": {
              "type": "integer",
              "minimum": 1,
              "title": "Interval",
              "default": 2
            },
            "verify": {
              "type": "boolean",
              "title": "Verify TLS",
              "description": "Verify the TLS certificate of the endpoint",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "title": "Existing secret",
              "description": "Name of an existing Secret with the optional keys bearer-token and auth",
              "default": ""
            }
          }
        }
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "title": "Project / namespace context",
      "description": "Properties of the project context.",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "title": "Scope name",
          "description": "Name of the global scope for this application. Define an organizational tenant.",
          "default": "myscope",
          "examples": [
            "myscope",
            "mycustomer"
          ]
        },
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "title": "Cluster name",
          "description": "Name of the cluster running this application. Define a platform tenant.",
          "default": "localhost",
          "examples": [
            "mycluster",
            "localhost"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "title": "Environment name",
          "description": "Name of the environment for this application. Define a stage tenant.",
          "default": "dev",
          "examples": [
            "dev",
            "factory",
            "preprod",
            "prod"
          ]
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "title": "Component name",
          "description": "Name of the component consisting of this application. Define a logical tenant.",
          "default": "mycomp",
          "examples": [
            "mycomp",
            "myservice"
          ]
        },
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "title": "Application name",
          "description": "Name of the application name. Define a functional tenant.",
          "default": "default-project",
          "examples": [
            "myapp",
            "mymicroservice"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "title": "Version name",
          "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
          "default": "0.0.1",
          "examples": [
            "0.0.1",
            "0.1",
            "0.0.1-snapshot",
            "0.0.1-202110300900"
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable the namespace/project creation",
          "description": "Enable creation of the namespace or project. Is required to be enabled if you want to create the resource.",
          "default": true
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "project": {
          "type": "object",
          "title": "Project / namespace definition",
          "description": "Information about the project or namespace definition.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable namespace / project creation",
              "description": "Enable the creation of the project or namespace.",
              "default": true
            },
            "infra": {
              "type": "boolean",
              "title": "Enable infra nodes",
              "description": "Enable workload located into infra nodes",
              "default": false
            },
            "hooked": {
              "type": "boolean",
              "title": "Helm hook",
              "description": "Project or namespace creation is done as an helm hook. Should be set to true if type is project (helm doesn't recognize project resource as it does for namespace)",
              "default": false
            },
            "name": {
              "type": "string",
              "title": "Name",
              "description": "Name of the project or namespace.",
              "default": "my-project",
              "examples": [
                "default-project",
                "my-project",
                "my-app"
              ]
            },
            "nodeSelector": {
              "type": "string",
              "title": "Node selector",
              "description": "A Node selector condition to set at the project level",
              "default": false,
              "examples": [
                "node-role.kubernetes.io/infra=",
                "node-role.kubernetes.io/worker=",
                "node-role.kubernetes.io/app=",
                "machine.startx.io/group=app-small",
                "machine.startx.io/group=app-big",
                "cpu-feature.node.kubevirt.io/acpi=true"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "project",
                "namespace"
              ],
              "title": "Kind of resource",
              "description": "Kind of resource to use for namespace isolation. Project kind should be used against Openshift clusters.",
              "default": "namespace",
              "examples": [
                "project",
                "namespace"
              ]
            },
            "display_name": {
              "type": "string",
              "title": "Display name",
              "description": "Display name of the project. Only apply to project (Openshift) type.",
              "default": "MY project",
              "examples": [
                "Default project",
                "MY project"
              ]
            },
            "description": {
              "type": "string",
              "title": "Description",
              "description": "Description of the project. Only apply to project (Openshift) type.",
              "default": "MY project description",
              "examples": [
                "Default project description",
                "MY project description"
              ]
            }
          }
        },
        "dockercfg": {
          "type": "object",
          "title": "Container registry credentials",
          "description": "Creation of secret holding registry access credentials at the namespace level. Could be used with imagePull option available in the serviceAccount section.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable namespace scoped Dockercfg secret",
              "description": "Enable the creation of various dockercfg at the namespace / project level. This file hold credentials for container images repository access. Could be linked with service accounts (see serviceAccounts section).",
              "default": false
            },
            "list": {
              "title": "Dockercfg list",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "Credential name",
                    "description": "Name of the credential to create.",
                    "default": "corp-registrycreds-repositoryname",
                    "examples": [
                      "corp-registrycreds-repositoryname",
                      "my-repository-name",
                      "corp-repository-name"
                    ]
                  },
                  "namespace": {
                    "type": "string",
                    "title": "Credential namespace",
                    "description": "Namespace where the credential must reside.",
                    "default": "default-project",
                    "examples": [
                      "default-project",
                      "default"
                    ]
                  },
                  "registry": {
                    "type": "string",
                    "title": "Registry",
                    "description": "Domain name of the registry to use.",
                    "default": "docker.io",
                    "examples": [
                      "docker.io",
                      "quay.io"
                    ]
                  },
                  "username": {
                    "type": "string",
                    "title": "User name",
                    "description": "Name of the user used to connect to the registry.",
                    "default": "myusername",
                    "examples": [
                      "myusername",
                      "username"
                    ]
                  },
                  "password": {
                    "type": "string",
                    "title": "Password",
                    "description": "Password coresponding to the user declared for the registry access.",
                    "default": "xxxxxx"
                  },
                  "email": {
                    "type": "string",
                    "title": "E-mail",
                    "description": "Email associated to the registry user.",
                    "default": "my@example.com",
                    "examples": [
                      "my@example.com",
                      "my@corp.com"
                    ]
                  }
                }
              }
            }
          }
        },
        "serviceAccounts": {
          "type": "object",
          "title": "Service Account management",
          "description": "Creation of ServiceAccount. Could link secret holding registry creds using the imagePullSecrets option.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable namespace scoped serviceAccounts",
              "description": "Enable the creation of various serviceAccounts at the namespace / project level. This list hold all serviceAccounts managed by this chart.",
              "default": false
            },
            "list": {
              "title": "ServiceAccounts list",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "serviceAccount name",
                    "description": "Name of the serviceAccount to create.",
                    "default": "default-project",
                    "examples": [
                      "default",
                      "builder"
                    ]
                  },
                  "imagePullSecrets": {
                    "type": "array",
                    "title": "imagePullSecrets list",
                    "description": "List of secrets used for imagePull requests.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "title": "Secret name",
                          "description": "Name of the secret to link to this serviceAccount for imagePull.",
                          "default": "corp-registrycreds-repositoryname",
                          "examples": [
                            "corp-registrycreds-repositoryname",
                            "my-repository-name",
                            "corp-repository-name"
                          ]
                        },
                        "namespace": {
                          "type": "string",
                          "title": "Secret namespace",
                          "description": "Namespace of the secret to link to this serviceAccount for imagePull.",
                          "default": "default-project",
                          "examples": [
                            "default-project",
                            "default"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "quotas": {
          "type": "object",
          "title": "Quota management",
          "description": "Creation of ResourceQuota in the namespace to restrict resource consumption. see https://kubernetes.io/docs/concepts/policy/resource-quotas",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable quotas into the namespace",
              "description": "Enable the creation of ResourceQuotas in this project / namespace.",
              "default": false
            },
            "rules": {
              "type": "string",
              "title": "Rules",
              "description": "List quotas rules to apply to this project / namespace. You can set whatever is supported in the spec of the ResourceQuota kubernetes resource. See https://kubernetes.io/docs/concepts/policy/resource-quotas for more information.",
              "default": "hard:\n  limits.cpu: '400m'",
              "examples": [
                "hard:\n  limits.cpu: '400m'"
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "title": "LimitRanges management",
          "description": "Creation of LimitRanges in the namespace to restrict resource consumption. see https://kubernetes.io/docs/concepts/policy/limit-range",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable limit ranges into the namespace",
              "description": "Enable the creation of LimitRanges in this project / namespace.",
              "default": false
            },
            "rules": {
              "type": "string",
              "title": "Rules",
              "description": "List limit ranges rules to apply to this project / namespace. You can set whatever is supported in the spec of the LimitRanges kubernetes resource. See https://kubernetes.io/docs/concepts/policy/limit-range for more information.",
              "default": "limits:\n  - type: Pod\n    max:\n      cpu: 200m",
              "examples": [
                "limits:\n  - type: Pod\n    max:\n      cpu: 200m"
              ]
            }
          }
        },
