{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "context": {
            "type": "object",
            "title": "Deployment context",
            "description": "Properties of the deployment context.",
            "required": [
                "scope",
                "cluster",
                "environment",
                "component",
                "app"
            ],
            "properties": {
                "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Scope name",
                    "description": "Name of the global scope for this application. Define an organizational tenant.",
                    "default": "myscope",
                    "examples": [
                        "myscope",
                        "mycustomer"
                    ]
                },
                "cluster": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Cluster name",
                    "description": "Name of the cluster running this application. Define a platform tenant.",
                    "default": "localhost",
                    "examples": [
                        "mycluster",
                        "localhost"
                    ]
                },
                "environment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Environment name",
                    "description": "Name of the environment for this application. Define a stage tenant.",
                    "default": "dev",
                    "examples": [
                        "dev",
                        "factory",
                        "preprod",
                        "prod"
                    ]
                },
                "component": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 25,
                    "title": "Component name",
                    "description": "Name of the component consisting of this application. Define a logical tenant.",
                    "default": "sxapi",
                    "examples": [
                        "mycomp",
                        "myservice"
                    ]
                },
                "app": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "title": "Application name",
                    "description": "Name of the application name. Define a functional tenant.",
                    "default": "default-sxapi",
                    "examples": [
                        "myapp",
                        "mymicroservice"
                    ]
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "title": "Version name",
                    "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                    "default": "0.0.1",
                    "examples": [
                        "0.0.1",
                        "0.1",
                        "0.0.1-snapshot",
                        "0.0.1-202110300900"
                    ]
                }
            }
        },
        "alertmanager": {
            "type": "object",
            "properties": {
                "api": {
                    "type": "object",
                    "properties": {
                        "endpoint": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "pagerDutty": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string"
                        }
                    }
                },
                "receiverName": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "externalSecret": {
                    "$ref": "#/definitions/externalSecret"
                }
            }
        },
        "autoscaling": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "max": {
                    "type": "object",
                    "properties": {
                        "cores": {
                            "type": "integer"
                        },
                        "memory": {
                            "type": "integer"
                        },
                        "nodes": {
                            "type": "integer"
                        }
                    }
                },
                "min": {
                    "type": "object",
                    "properties": {
                        "cores": {
                            "type": "integer"
                        },
                        "memory": {
                            "type": "integer"
                        },
                        "nodes": {
                            "type": "integer"
                        }
                    }
                },
                "scaleDown": {
                    "type": "boolean"
                }
            }
        },
        "clusterversion": {
            "type": "object",
            "properties": {
                "channel": {
                    "type": "string"
                },
                "clusterID": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "title": "Version name",
                    "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                    "default": "4.16",
                    "examples": [
                        "4.16",
                        "4.15",
                        "4.14",
                        "4.13",
                        "4.12",
                        "4.11",
                        "4.10"
                    ]
                },
                "desiredVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "title": "Desired version",
                    "description": "Define the targeted applyed version (if cluster update are managed in a gitops way)",
                    "default": "4.16.37",
                    "examples": [
                        "4.16.37",
                        "4.15.37",
                        "4.14.6",
                        "4.13.26",
                        "4.12.1",
                        "4.11.18",
                        "4.11.17"
                    ]
                }
            }
        },
        "helm_reposistory": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "list": {
                    "type": "array"
                }
            }
        },
        "imageprunner": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "history": {
                    "type": "object",
                    "properties": {
                        "failed": {
                            "type": "integer"
                        },
                        "successful": {
                            "type": "integer"
                        }
                    }
                },
                "schedule": {
                    "type": "string"
                },
                "suspend": {
                    "type": "boolean"
                }
            }
        },
        "monitoring": {
            "type": "object",
            "title": "Monitoring",
            "description": "Configuration of the cluster monitoring feature (ConfigMap openshift-monitoring/cluster-monitoring-config)",
            "properties": {
                "enabled": {
                    "title": "Enabled",
                    "type": "boolean",
                    "default": false,
                    "description": "Enable the cluster monitoring customization"
                },
                "infra_enabled": {
                    "title": "Infra enabled",
                    "type": "boolean",
                    "default": false,
                    "description": "Deploy the monitoring components (except node-exporter) on the infra nodes"
                },
                "storageClass": {
                    "title": "Storage Class",
                    "type": "string",
                    "default": "gp3-csi",
                    "description": "Storage class of the Prometheus and Alertmanager persistent volumes (default is gp3-csi)"
                },
                "storageSize": {
                    "title": "Storage Size",
                    "type": "string",
                    "default": "20Gi",
                    "description": "Size of the Prometheus persistent volume, one per replica (default is 20Gi)"
                },
                "storageSizeAlert": {
                    "title": "Storage Size Alert",
                    "type": "string",
                    "default": "5Gi",
                    "description": "Size of the Alertmanager persistent volume, one per replica (default is 5Gi)"
                },
                "enableUserWorkload": {
                    "title": "Enable User Workload",
                    "type": "boolean",
                    "default": false,
                    "description": "Enable the monitoring of user-defined projects (see the userWorkload block for its configuration)"
                },
                "retentionPeriod": {
                    "title": "Retention Period",
                    "type": "string",
                    "default": "7d",
                    "description": "Prometheus data retention duration (default is 7d)"
                },
                "retentionSize": {
                    "title": "Retention Size",
                    "type": "string",
                    "default": "",
                    "description": "Prometheus maximum data size on disk, ex: 40GB (about 80% of storageSize). Empty keeps only the time-based retention"
                },
                "resources": {
                    "type": "object",
                    "title": "Resources",
                    "description": "Resource requests and limits of the Prometheus pods",
                    "default": {
                        "requests": {
                            "cpu": "200m",
                            "memory": "2Gi"
                        }
                    }
                },
                "externalLabels": {
                    "type": "object",
                    "title": "External Labels",
                    "description": "Labels added by Prometheus to every metric and alert leaving the cluster (remote write, federation, alert receivers)",
                    "properties": {
                        "contextLabels": {
                            "title": "Context Labels",
                            "type": "boolean",
                            "default": true,
                            "description": "Add the scope, environment and cluster_name labels from the deployment context. The keys prometheus, prometheus_replica and cluster are reserved by OpenShift 4.19+ and rejected by the monitoring webhook"
                        },
                        "custom": {
                            "type": "object",
                            "title": "Custom",
                            "description": "Additional labels (key: value)",
                            "default": {}
                        }
                    }
                },
                "remoteWrite": {
                    "type": "array",
                    "title": "Remote Write",
                    "description": "Remote write endpoints of the platform Prometheus (list of remoteWrite settings, see the OpenShift documentation)",
                    "default": []
                },
                "alertmanager": {
                    "type": "object",
                    "title": "Alertmanager",
                    "description": "Platform Alertmanager",
                    "properties": {
                        "enabled": {
                            "title": "Enabled",
                            "type": "boolean",
                            "default": true,
                            "description": "Deploy the platform Alertmanager (false removes it, alerts must then be sent to an external Alertmanager)"
                        }
                    }
                },
                "extraConfig": {
                    "type": "object",
                    "title": "Extra Config",
                    "description": "Additional cluster-monitoring-config settings added as-is at the end of config.yaml (keys managed by this chart must not be repeated)",
                    "default": {}
                },
                "userWorkload": {
                    "type": "object",
                    "title": "User Workload",
                    "description": "Monitoring of user-defined projects (ConfigMap openshift-user-workload-monitoring/user-workload-monitoring-config), requires enableUserWorkload",
                    "properties": {
                        "enabled": {
                            "title": "Enabled",
                            "type": "boolean",
                            "default": false,
                            "description": "Manage the user-workload-monitoring-config ConfigMap"
                        },
                        "retentionPeriod": {
                            "title": "Retention Period",
                            "type": "string",
                            "default": "24h",
                            "description": "Data retention duration of the user workload Prometheus (default is 24h)"
                        },
                        "retentionSize": {
                            "title": "Retention Size",
                            "type": "string",
                            "default": "",
                            "description": "Maximum data size on disk of the user workload Prometheus. Empty keeps only the time-based retention"
                        },
                        "storageClass": {
                            "title": "Storage Class",
                            "type": "string",
                            "default": "",
                            "description": "Storage class of the user workload Prometheus persistent volume (empty uses monitoring.storageClass)"
                        },
                        "storageSize": {
                            "title": "Storage Size",
                            "type": "string",
                            "default": "10Gi",
                            "description": "Size of the user workload Prometheus persistent volume, one per replica (default is 10Gi)"
                        },
                        "resources": {
                            "type": "object",
                            "title": "Resources",
                            "description": "Resource requests and limits of the user workload Prometheus pods",
                            "default": {}
                        },
                        "extraConfig": {
                            "type": "object",
                            "title": "Extra Config",
                            "description": "Additional user-workload-monitoring-config settings added as-is at the end of its config.yaml",
                            "default": {}
                        }
                    }
                }
            }
        },
        "operatorElastic": {
            "type": "object",
            "properties": {
                "context": {
                    "type": "object",
                    "properties": {
                        "app": {
                            "type": "string"
                        },
                        "cluster": {
                            "type": "string"
                        },
                        "component": {
                            "type": "string"
                        },
                        "environment": {
                            "type": "string"
                        },
                        "scope": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "operatorGroup": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "providedAPIs": {
                            "type": "string"
                        },
                        "target": {
                            "type": "string"
                        }
                    }
                },
                "subscription": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        },
                        "operator": {
                            "type": "object",
                            "properties": {
                                "channel": {
                                    "type": "string"
                                },
                                "csv": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "source": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "namespace": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 30,
                            "title": "Version name",
                            "description": "Name of the application version. Define this deployment version. Should be incremented each time application configuration is changed to keep track of changes and allow ease rollin of the application (and rollout in case of problem). Default use Chart appVersion.",
                            "default": "0.0.1",
                            "examples": [
                                "0.0.1",
                                "0.1",
                                "0.0.1-snapshot",
                                "0.0.1-202110300900"
                            ]
                        }
                    }
                }
            }
        },
        "project": {
            "type": "object",
            "properties": {
                "context": {
                    "type": "object",
                    "properties": {
                        "app": {
                            "type": "string"
                        },
                        "cluster": {
                            "type": "string"
                        },
                        "component": {
                            "type": "string"
                        },
                        "environment": {
                            "type": "string"
                        },
                        "scope": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "project": {
                    "type": "object",
                    "properties": {
                        "description": {
                            "type": "string"
                        },
                        "display_name": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "hooked": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "requester": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "projecttemplate": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "networkpolicy": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "rbac": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "redhat": {
            "type": "object",
            "properties": {
                "operators": {
                    "type": "boolean"
                }
            }
        },
        "tracing": {
            "type": "object",
            "properties": {
                "operators": {
                    "type": "boolean"
                }
            }
        },
        "registryroute": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string"
                }
            }
        },
        "externalSecretDefaults": {
            "type": "object",
            "description": "Default settings of the ExternalSecret objects rendered by this chart",
            "properties": {
                "apiVersion": {
                    "type": "string"
                },
                "refreshInterval": {
                    "type": "string"
                },
                "secretStoreRef": {
                    "$ref": "#/definitions/externalSecretStoreRef"
                }
            }
        },
        "api": {
            "type": "object",
            "properties": {
                "externalSecret": {
                    "$ref": "#/definitions/externalSecret"
                }
            }
        },
        "registryconfig": {
            "type": "object",
            "properties": {
                "externalSecret": {
                    "$ref": "#/definitions/externalSecret"
                }
            }
        },
        "ingresscontroller": {
            "type": "object",
            "properties": {
                "list": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "certificate": {
                                "type": "object",
                                "properties": {
                                    "externalSecret": {
                                        "$ref": "#/definitions/externalSecret"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "externalSecretStoreRef": {
            "type": "object",
            "description": "SecretStore or ClusterSecretStore to read from",
            "properties": {
                "name": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "SecretStore",
                        "ClusterSecretStore"
                    ]
                }
            }
        },
        "externalSecret": {
            "type": "object",
            "description": "Source this secret from an external store (External Secrets Operator ExternalSecret) instead of the chart values",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Render an ExternalSecret producing the same Secret instead of the Secret itself"
                },
                "apiVersion": {
                    "type": "string"
                },
                "refreshInterval": {
                    "type": "string"
                },
                "secretStoreRef": {
                    "$ref": "#/definitions/externalSecretStoreRef"
                },
                "remoteRefs": {
                    "type": "object",
                    "description": "Map of target secret keys to ExternalSecret remoteRef",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "key": {
                                "type": "string"
                            },
                            "property": {
                                "type": "string"
                            },
                            "version": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "key"
                        ]
                    }
                },
                "data": {
                    "type": "array",
                    "description": "Raw ExternalSecret spec.data entries",
                    "items": {
                        "type": "object"
                    }
                },
                "dataFrom": {
                    "type": "array",
                    "description": "Raw ExternalSecret spec.dataFrom entries",
                    "items": {
                        "type": "object"
                    }
                },
                "template": {
                    "type": "object",
                    "description": "Raw ExternalSecret spec.target.template"
                }
            }
        }
    }
}
