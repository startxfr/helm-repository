{{/* vim: set filetype=mustache: */}}

{{/* STARTX Cluster config helpers */}}

{{/* Common labels */}}
{{- define "cluster-quay.labels" -}}
{{ include "startx.labelsInfra" . }}
app.kubernetes.io/instance: {{ include "startx.appNameVersion" . | quote }}
{{- end -}}

{{/* Common cluster-quay annotations */}}
{{- define "cluster-quay.annotations" -}}
{{ include "startx.annotationsInfra" . }}
{{- end -}}

{{/* Common operator note */}}
{{- define "cluster-quay.notes" -}}
-- Quay registry -------------------
{{- if .quay }}{{- if .quay.enabled }}
         quay : enabled
{{- if .quay.config }}{{- if .quay.config.enabled }}
       config : rendered by the chart (storage {{ .storage.mode }}, database {{ .database.mode }}{{ if .oidc.enabled }}, OIDC login {{ .oidc.serviceName }}{{ end }})
{{- else }}
       config : generated by the operator (every component managed)
{{- end }}{{- end }}
{{- end }}{{- end }}
{{- if .rhn }}{{- if .rhn.enabled }}
          RHN : enabled with user {{ .rhn.user }}
{{- end }}{{- end }}
{{- end -}}

{{/* Namespace of the registry objects */}}
{{- define "cluster-quay.namespace" -}}
{{- .Values.project.project.name | default "default-quay" -}}
{{- end -}}

{{/* Name of the QuayRegistry */}}
{{- define "cluster-quay.registryName" -}}
{{- .Values.quay.name | default (include "startx.appName" .) -}}
{{- end -}}

{{/* true when the chart renders the config bundle or references an existing one */}}
{{- define "cluster-quay.hasConfig" -}}
{{- if or .Values.quay.config.enabled .Values.quay.config.existingSecret -}}true{{- end -}}
{{- end -}}

{{/* true when Quay and Clair reach databases outside the Quay operator (crunchy, cloudnativedb, external) */}}
{{- define "cluster-quay.unmanagedDb" -}}
{{- if and (include "cluster-quay.hasConfig" .) (ne .Values.database.mode "quayOperator") -}}true{{- end -}}
{{- end -}}

{{/* Default namespace of the clusters of a database sub-chart: dict "root" $ "chart" crunchy|cloudnativedb */}}
{{- define "cluster-quay.dbChartNamespace" -}}
{{- $sub := index .root.Values .chart | default dict -}}
{{- $name := "" -}}
{{- if and $sub.project $sub.project.project -}}{{- $name = $sub.project.project.name -}}{{- end -}}
{{- $name | default (printf "cluster-%s" .chart) -}}
{{- end -}}

{{/* Entry of <chart>.cluster.list named <name>, as yaml: dict "root" $ "chart" crunchy|cloudnativedb "name" <name> */}}
{{- define "cluster-quay.dbClusterEntry" -}}
{{- $found := dict -}}
{{- $sub := index .root.Values .chart | default dict -}}
{{- range ($sub.cluster | default dict).list -}}
{{- if eq .name $.name -}}{{- $found = . -}}{{- end -}}
{{- end -}}
{{- toYaml $found -}}
{{- end -}}

{{/* Connection settings of a database (host, port, database, user, password), as yaml: dict "root" $ "db" quay|clair */}}
{{- define "cluster-quay.dbSettings" -}}
{{- $root := .root -}}
{{- $mode := $root.Values.database.mode -}}
{{- $d := index $root.Values.database .db -}}
{{- $out := dict "host" ($d.host | default "") "port" (toString ($d.port | default 5432)) "database" ($d.database | default "") "user" ($d.user | default "") "password" ($d.password | default "") -}}
{{- if has $mode (list "crunchy" "cloudnativedb" "percona") -}}
{{- $entry := include "cluster-quay.dbClusterEntry" (dict "root" $root "chart" $mode "name" $d.cluster) | fromYaml -}}
{{- $ns := $entry.namespace | default (include "cluster-quay.dbChartNamespace" (dict "root" $root "chart" $mode)) -}}
{{- $suffix := ternary "rw" "primary" (eq $mode "cloudnativedb") -}}
{{- if not $out.host -}}{{- $_ := set $out "host" (printf "%s-%s.%s.svc" $d.cluster $suffix $ns) -}}{{- end -}}
{{- if not $out.database -}}{{- $_ := set $out "database" ($entry.database | default $entry.name | default "") -}}{{- end -}}
{{- if not $out.user -}}{{- $_ := set $out "user" ($entry.username | default $entry.name | default "") -}}{{- end -}}
{{- if not $out.password -}}{{- $_ := set $out "password" ($entry.password | default "") -}}{{- end -}}
{{- end -}}
{{- toYaml $out -}}
{{- end -}}

{{/* DB_URI of Quay */}}
{{- define "cluster-quay.dbUri" -}}
{{- $s := include "cluster-quay.dbSettings" (dict "root" . "db" "quay") | fromYaml -}}
{{- $uri := printf "postgresql://%s:%s@%s:%s/%s?sslmode=%s" $s.user $s.password $s.host $s.port $s.database .Values.database.tls.mode -}}
{{- if eq .Values.database.tls.mode "verify-full" -}}
{{ $uri }}&sslrootcert=/.postgresql/root.crt
{{- else -}}
{{ $uri }}
{{- end -}}
{{- end -}}

{{/* Connection string of Clair */}}
{{- define "cluster-quay.clairConnString" -}}
{{- $s := include "cluster-quay.dbSettings" (dict "root" . "db" "clair") | fromYaml -}}
{{- $conn := printf "host=%s port=%s dbname=%s user=%s password=%s sslmode=%s pool_max_conns=33" $s.host $s.port $s.database $s.user $s.password .Values.database.tls.mode -}}
{{- if eq .Values.database.tls.mode "verify-full" -}}
{{ $conn }} sslrootcert=/var/run/certs/postgres-ca.crt
{{- else -}}
{{ $conn }}
{{- end -}}
{{- end -}}

{{/* Validation of the values: fails the rendering with an explicit message */}}
{{- define "cluster-quay.validate" -}}
{{- $v := .Values -}}
{{- $q := $v.quay -}}
{{- $db := $v.database -}}
{{- if not (has $db.mode (list "quayOperator" "crunchy" "cloudnativedb" "percona" "external")) -}}
{{- fail (printf "database.mode must be one of quayOperator, crunchy, cloudnativedb, percona, external (got %q)" (toString $db.mode)) -}}
{{- end -}}
{{- if not (has $v.storage.mode (list "operator" "external")) -}}
{{- fail (printf "storage.mode must be operator or external (got %q)" (toString $v.storage.mode)) -}}
{{- end -}}
{{- if not (has $db.tls.mode (list "require" "verify-full")) -}}
{{- fail (printf "database.tls.mode must be require or verify-full (got %q)" (toString $db.tls.mode)) -}}
{{- end -}}
{{- if not (include "cluster-quay.hasConfig" .) -}}
{{- /* Configuration generated by the operator: every component is managed */ -}}
{{- if ne $db.mode "quayOperator" -}}{{- fail (printf "database.mode %s requires quay.config.enabled (the config bundle carries DB_URI) or quay.config.existingSecret" $db.mode) -}}{{- end -}}
{{- if ne $v.storage.mode "operator" -}}{{- fail "storage.mode external requires quay.config.enabled (the config bundle carries DISTRIBUTED_STORAGE_CONFIG) or quay.config.existingSecret" -}}{{- end -}}
{{- if $v.oidc.enabled -}}{{- fail "oidc.enabled requires quay.config.enabled" -}}{{- end -}}
{{- if not $q.tls.managed -}}{{- fail "quay.tls.managed false requires quay.config.enabled (the config bundle carries ssl.cert and ssl.key)" -}}{{- end -}}
{{- end -}}
{{- if include "cluster-quay.unmanagedDb" . -}}
{{- if and (eq $db.tls.mode "verify-full") (not $db.tls.caCert) -}}
{{- fail "database.tls.caCert (PEM) is required when database.tls.mode is verify-full" -}}
{{- end -}}
{{- range $key := list "quay" "clair" -}}
{{- if or (eq $key "quay") $q.components.clair -}}
{{- $d := index $db $key -}}
{{- if has $db.mode (list "crunchy" "cloudnativedb" "percona") -}}
{{- $entry := include "cluster-quay.dbClusterEntry" (dict "root" $ "chart" $db.mode "name" $d.cluster) | fromYaml -}}
{{- if and (not $entry.name) (not $d.host) -}}
{{- fail (printf "database.%s.cluster %q is not an entry of %s.cluster.list (set it, or database.%s.host)" $key (toString $d.cluster) $db.mode $key) -}}
{{- end -}}
{{- end -}}
{{- $s := include "cluster-quay.dbSettings" (dict "root" $ "db" $key) | fromYaml -}}
{{- if not $s.host -}}{{- fail (printf "database.%s.host is required with database.mode %s" $key $db.mode) -}}{{- end -}}
{{- if not $s.database -}}{{- fail (printf "database.%s.database is required with database.mode %s" $key $db.mode) -}}{{- end -}}
{{- if not $s.user -}}{{- fail (printf "database.%s.user is required with database.mode %s" $key $db.mode) -}}{{- end -}}
{{- if not $s.password -}}
{{- if has $db.mode (list "crunchy" "cloudnativedb" "percona") -}}
{{- fail (printf "database.%s.password is required (secret): set password on the entry %q of %s.cluster.list, or database.%s.password" $key (toString $d.cluster) $db.mode $key) -}}
{{- else -}}
{{- fail (printf "database.%s.password is required (secret)" $key) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if and $q.config.enabled (not $q.config.existingSecret) -}}
{{- if not $q.config.secretKey -}}{{- fail "quay.config.secretKey is required (secret, 64 random characters)" -}}{{- end -}}
{{- if not $q.config.databaseSecretKey -}}{{- fail "quay.config.databaseSecretKey is required (secret, 64 random characters)" -}}{{- end -}}
{{- if and (eq $v.storage.mode "external") (not $v.storage.external.custom) -}}
{{- $s := $v.storage.external -}}
{{- if not (has $s.driver (list "RadosGWStorage" "S3Storage")) -}}
{{- fail (printf "storage.external.driver must be RadosGWStorage or S3Storage (got %q); use storage.external.custom for other drivers" (toString $s.driver)) -}}
{{- end -}}
{{- if and (eq $s.driver "RadosGWStorage") (not $s.host) -}}{{- fail "storage.external.host is required with the RadosGWStorage driver" -}}{{- end -}}
{{- if and (eq $s.driver "S3Storage") (not $s.region) -}}{{- fail "storage.external.region is required with the S3Storage driver (Amazon S3; use RadosGWStorage for any other endpoint)" -}}{{- end -}}
{{- if not $s.bucket -}}{{- fail "storage.external.bucket is required" -}}{{- end -}}
{{- if not $s.accessKey -}}{{- fail "storage.external.accessKey is required (secret)" -}}{{- end -}}
{{- if not $s.secretKey -}}{{- fail "storage.external.secretKey is required (secret)" -}}{{- end -}}
{{- end -}}
{{- if $v.oidc.enabled -}}
{{- if not $v.oidc.server -}}{{- fail "oidc.server is required when oidc.enabled (issuer URL with a trailing slash)" -}}{{- end -}}
{{- if not (hasSuffix "/" $v.oidc.server) -}}{{- fail (printf "oidc.server must end with a trailing slash (got %q): Quay refuses the configuration otherwise" $v.oidc.server) -}}{{- end -}}
{{- if not $v.oidc.clientId -}}{{- fail "oidc.clientId is required when oidc.enabled" -}}{{- end -}}
{{- if not $v.oidc.clientSecret -}}{{- fail "oidc.clientSecret is required when oidc.enabled (secret)" -}}{{- end -}}
{{- if not $v.oidc.serviceName -}}{{- fail "oidc.serviceName is required when oidc.enabled" -}}{{- end -}}
{{- if has ($v.oidc.serviceName | lower) (list "ldap" "jwt" "keystone" "github" "google" "gitlab") -}}{{- fail (printf "oidc.serviceName %q is reserved by Quay: use another name (e.g. SSO, Keycloak)" $v.oidc.serviceName) -}}{{- end -}}
{{- end -}}
{{- if and (not $q.components.route) (not $q.config.hostname) -}}
{{- fail "quay.config.hostname is required when quay.components.route is false (the operator demands SERVER_HOSTNAME for an unmanaged route)" -}}
{{- end -}}
{{- if not $q.tls.managed -}}
{{- if or (not $q.tls.cert) (not $q.tls.key) -}}{{- fail "quay.tls.cert and quay.tls.key (PEM) are required when quay.tls.managed is false" -}}{{- end -}}
{{- end -}}
{{- /* Documentation placeholders (<value>) left in the non secret values in use; Argo CD Vault Plugin placeholders (<path:...>) are allowed */ -}}
{{- $ph := dict "quay.config.hostname" $q.config.hostname -}}
{{- if and (eq $v.storage.mode "external") (not $v.storage.external.custom) -}}
{{- $_ := set $ph "storage.external.host" $v.storage.external.host -}}
{{- $_ := set $ph "storage.external.bucket" $v.storage.external.bucket -}}
{{- $_ := set $ph "storage.external.region" $v.storage.external.region -}}
{{- end -}}
{{- if $v.oidc.enabled -}}{{- $_ := set $ph "oidc.server" $v.oidc.server -}}{{- end -}}
{{- if ne $db.mode "quayOperator" -}}
{{- $qs := include "cluster-quay.dbSettings" (dict "root" $ "db" "quay") | fromYaml -}}
{{- $_ := set $ph "database.quay.host" $qs.host -}}
{{- if $q.components.clair -}}
{{- $cs := include "cluster-quay.dbSettings" (dict "root" $ "db" "clair") | fromYaml -}}
{{- $_ := set $ph "database.clair.host" $cs.host -}}
{{- end -}}
{{- end -}}
{{- range $name, $val := $ph -}}
{{- $s := toString $val -}}
{{- if and (contains "<" $s) (not (contains "<path:" $s)) -}}
{{- fail (printf "%s still holds the placeholder %s: replace it with the value of your environment" $name $s) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{/* config.yaml of the registry, as a dict */}}
{{- define "cluster-quay.config" -}}
{{- $v := .Values -}}
{{- $c := $v.quay.config -}}
{{- $cfg := dict
  "REGISTRY_TITLE" $c.registryTitle
  "REGISTRY_TITLE_SHORT" $c.registryTitleShort
  "AUTHENTICATION_TYPE" "Database"
  "FEATURE_USER_INITIALIZE" $c.userInitialize
  "FEATURE_USER_CREATION" $c.userCreation
  "SUPER_USERS" $c.superUsers
  "DEFAULT_TAG_EXPIRATION" $c.defaultTagExpiration
  "TAG_EXPIRATION_OPTIONS" $c.tagExpirationOptions
  "SECRET_KEY" $c.secretKey
  "DATABASE_SECRET_KEY" $c.databaseSecretKey
-}}
{{- if $c.hostname -}}
{{- $_ := set $cfg "SERVER_HOSTNAME" $c.hostname -}}
{{- end -}}
{{- if include "cluster-quay.unmanagedDb" . -}}
{{- $_ := set $cfg "DB_URI" (include "cluster-quay.dbUri" .) -}}
{{- $args := dict "autorollback" true "threadlocals" true "sslmode" $v.database.tls.mode -}}
{{- if eq $v.database.tls.mode "verify-full" -}}{{- $_ := set $args "sslrootcert" "/.postgresql/root.crt" -}}{{- end -}}
{{- $_ := set $cfg "DB_CONNECTION_ARGS" $args -}}
{{- end -}}
{{- if eq $v.storage.mode "external" -}}
{{- $s := $v.storage.external -}}
{{- $_ := set $cfg "DISTRIBUTED_STORAGE_PREFERENCE" (list "default") -}}
{{- $_ := set $cfg "DISTRIBUTED_STORAGE_DEFAULT_LOCATIONS" (list "default") -}}
{{- if $s.custom -}}
{{- $_ := set $cfg "DISTRIBUTED_STORAGE_CONFIG" $s.custom -}}
{{- else if eq $s.driver "S3Storage" -}}
{{- /* Quay derives the endpoint from s3_region (s3.<region>.amazonaws.com): host and port would be ignored */ -}}
{{- $d := dict "s3_bucket" $s.bucket "s3_access_key" $s.accessKey "s3_secret_key" $s.secretKey "s3_region" $s.region "storage_path" $s.storagePath -}}
{{- $_ := set $cfg "DISTRIBUTED_STORAGE_CONFIG" (dict "default" (list "S3Storage" $d)) -}}
{{- else -}}
{{- $d := dict "hostname" $s.host "is_secure" $s.isSecure "access_key" $s.accessKey "secret_key" $s.secretKey "bucket_name" $s.bucket "storage_path" $s.storagePath "signature_version" "v4" -}}
{{- if $s.port -}}{{- $_ := set $d "port" (int $s.port) -}}{{- end -}}
{{- if $s.region -}}{{- $_ := set $d "region_name" $s.region -}}{{- end -}}
{{- $_ := set $cfg "DISTRIBUTED_STORAGE_CONFIG" (dict "default" (list "RadosGWStorage" $d)) -}}
{{- end -}}
{{- end -}}
{{- if $v.oidc.enabled -}}
{{- $o := $v.oidc -}}
{{- $_ := set $cfg "FEATURE_USER_CREATION" true -}}
{{- if $o.internalAuthentication -}}
{{- $_ := set $cfg "AUTHENTICATION_TYPE" "OIDC" -}}
{{- $_ := set $cfg "FEATURE_TEAM_SYNCING" $o.teamSyncing -}}
{{- if $o.nonSuperuserTeamSyncingSetup -}}{{- $_ := set $cfg "FEATURE_NONSUPERUSER_TEAM_SYNCING_SETUP" true -}}{{- end -}}
{{- end -}}
{{- $login := dict
  "SERVICE_NAME" $o.serviceName
  "OIDC_SERVER" $o.server
  "CLIENT_ID" $o.clientId
  "CLIENT_SECRET" $o.clientSecret
  "LOGIN_SCOPES" $o.loginScopes
  "PREFERRED_USERNAME_CLAIM_NAME" $o.usernameClaim
  "VERIFIED_EMAIL_CLAIM_NAME" $o.emailClaim
-}}
{{- if $o.groupClaim -}}{{- $_ := set $login "PREFERRED_GROUP_CLAIM_NAME" $o.groupClaim -}}{{- end -}}
{{- if $o.pkce -}}{{- $_ := set $login "USE_PKCE" true -}}{{- $_ := set $login "PKCE_METHOD" "S256" -}}{{- end -}}
{{- $_ := set $cfg (printf "%s_LOGIN_CONFIG" ($o.serviceName | upper)) $login -}}
{{- end -}}
{{- $cfg = mergeOverwrite $cfg (deepCopy $c.extraConfig) -}}
{{- toYaml $cfg -}}
{{- end -}}
