{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "context": {
            "type": "object",
            "properties": {
                "app": {
                    "type": "string"
                },
                "cluster": {
                    "type": "string"
                },
                "component": {
                    "type": "string"
                },
                "environment": {
                    "type": "string"
                },
                "scope": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "etcdBackup": {
            "type": "object",
            "properties": {
                "alerting": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "noBackupForHours": {
                            "type": "integer"
                        },
                        "severity": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "failedJobsHistoryLimit": {
                    "type": "integer"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "keep_count": {
                    "type": "integer"
                },
                "keep_days": {
                    "type": "integer"
                },
                "namespace": {
                    "type": "string"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "s3CaCert": {
                    "type": "string"
                },
                "s3_bucket_name": {
                    "type": "string"
                },
                "s3_endpoint": {
                    "type": "string"
                },
                "s3_region": {
                    "type": "string"
                },
                "s3_secret": {
                    "type": "object",
                    "properties": {
                        "s3_access_key": {
                            "type": "string"
                        },
                        "s3_secret_key": {
                            "type": "string"
                        },
                        "secretName": {
                            "type": "string"
                        }
                    }
                },
                "schedule": {
                    "type": "string"
                },
                "startingDeadlineSeconds": {
                    "type": "integer"
                },
                "successfulJobsHistoryLimit": {
                    "type": "integer"
                },
                "useS3Ca": {
                    "type": "boolean"
                }
            }
        },
        "project": {
            "type": "object",
            "properties": {
                "context": {
                    "type": "object",
                    "properties": {
                        "app": {
                            "type": "string"
                        },
                        "cluster": {
                            "type": "string"
                        },
                        "component": {
                            "type": "string"
                        },
                        "environment": {
                            "type": "string"
                        },
                        "scope": {
                            "type": "string"
                        },
                        "version": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "networkpolicy": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "project": {
                    "type": "object",
                    "properties": {
                        "description": {
                            "type": "string"
                        },
                        "display_name": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string"
                        }
                    }
                },
                "quotas": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "rbac": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        }
    }
}
