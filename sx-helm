#!/bin/bash
PROJECT_PATH=$(dirname "$(readlink -f "$0")")
export PROJECT_CHARTPATH=$PROJECT_PATH/charts
PROJECT_LIBPATH=$PROJECT_PATH/.tools

# shellcheck source=/dev/null
source "$PROJECT_LIBPATH/cli"
source "$PROJECT_LIBPATH/cli-s3"

# The whole router lives in a function, called on the same line as the exit : bash reads a script while it runs, and release
# checks out other branches that rewrite this very file, which would make bash read garbage after the router.
main() {
    ## Command router

    if [[ "$1" != "" ]]; then
        case $1 in
            list)            routerList;;
            publish)         routerPublish;;
            publish-devel)   routerPublishDevel;;
            release)         routerRelease "$@";;
            release-charts)  routerReleaseChartsOnly;;
            changed-charts)  routerListChanged;;
            archive)         routerArchive "$@";;
            archiveLegacy)   routerArchiveLegacy "$@";;
            lint-all)        routerLintAll;;
            test-all)        routerTestAll;;
            package-all)     routerPackageAll;;
            history-prune-all) routerHistoryPruneAll "$2";;
            syncfroms3)      routerSyncFromS3 "$@";;
            synctos3)        routerSyncToS3 "$@";;
            version)         routerVersion;;
            *)
                case $2 in
                    info)       routerChartInfo "$1";;
                    create)     routerChartCreate "$1" "$3";;
                    schemagen)  routerChartSchemagen "$1" "$3";;
                    test)       routerChartTest "$1" "$3" "$4";;
                    package)    routerChartPackage "$1";;
                    history-prune) routerChartHistoryPrune "$1" "$3";;
                    release)    routerChartRelease "$1" "$3" "$4" "$5";;
                    delete)     routerChartDelete "$1" "$3";;
                    publish)    routerChartPublish "$@";;
                    *)          menuUsageChart "$@";;
                esac
            ;;
        esac
    else
        menuUsage
    fi
}

main "$@"; exit $?
